# Copy to backend/.env and fill in the team key. Never commit .env.

# Akamai hosted inference (OpenAI-compatible). Names match the Hack Midwest starter kit.
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=
CHAT_MODEL=hackathon-chat

# Comma-separated origins allowed to call the API directly (the Next.js dev proxy does not need this).
CORS_ORIGINS=http://localhost:3000

# SQLite file and candle cache directory (relative to backend/).
DATABASE_PATH=data/strategylab.db
CANDLE_CACHE_DIR=data/candles
