# Copy to backend/.env and fill in the team key. Never commit .env.

# Akamai hosted inference (OpenAI-compatible). Names match the Hack Midwest starter kit.
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=
CHAT_MODEL=hackathon-chat

# Output limits per AI request (128..32768; provider/model limits still apply).
AI_TREND_INITIAL_TOKENS=700
AI_TREND_MAX_TOKENS=2800
AI_STRATEGY_MAX_TOKENS=2000
AI_REPORT_MAX_TOKENS=1600
AI_EXPLANATION_MAX_TOKENS=900

# Spot XAUUSD history (Twelve Data key with commodity access).
TWELVEDATA_API_KEY=
MASSIVE_API_KEY=
GOLD_PROVIDER=twelvedata

# Stock 5m/30m history provider: yahoo, twelvedata, or massive.
STOCK_INTRADAY_PROVIDER=yahoo
STOCK_INTRADAY_HISTORY_DAYS=365

# Comma-separated origins allowed to call the API directly (the Next.js dev proxy does not need this).
CORS_ORIGINS=http://localhost:3000

# SQLite file and candle cache directory (relative to backend/).
DATABASE_PATH=data/strategylab.db
CANDLE_CACHE_DIR=data/candles

# Read-only real-time paper signal feeds. No broker orders are submitted.
# Stocks: Alpaca real-time IEX feed (exchange-specific volume).
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Gold: OANDA practice account; XAU_USD availability depends on region/account.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
